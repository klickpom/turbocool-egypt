RewriteEngine On
RewriteBase /

# Apex is the canonical host
RewriteCond %{HTTP_HOST} ^www\.turbocool-egypt\.shop$ [NC]
RewriteRule ^(.*)$ https://turbocool-egypt.shop/$1 [L,R=301]

# Trailing slash → no slash (except homepage)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Real files and folders (assets, api, robots, sitemap, llms, schema)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^api/ - [L]

# SPA soft routes → index.html
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "^(llms|llms-full|ai)\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^schema\.jsonld$">
    Header set Content-Type "application/ld+json; charset=utf-8"
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(?:js|css|woff2|jpg|jpeg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
